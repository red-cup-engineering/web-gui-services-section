{
  "name": "@red-cup-engineering/web-gui-services-section",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Platform-neutral browser projection for witnessed worlds: immutable model in, accessible HTML/CSS/client geometry out.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/red-cup-engineering/web-gui-services-section.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check src/index.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "x-semiotic-voxel": {
    "profile": "org.harmonious-union.semiotic-voxel.v1",
    "owner": "red-cup-engineering",
    "kind": "capability-cell",
    "actor": "urn:ame:web-gui-services-section",
    "operations": [
      "render-witnessed-world-browser-projection"
    ],
    "capabilities": [
      {
        "capability": "web-gui-services-section",
        "faces": [
          "world-projection",
          "material-language",
          "accessible-browser-shell"
        ]
      }
    ],
    "package": "@red-cup-engineering/web-gui-services-section"
  }
}
